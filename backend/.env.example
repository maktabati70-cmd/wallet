# Copy to .env for local development. NEVER commit the real .env file.
APP_ENV=development

# PostgreSQL — the API should use the least-privilege role from 002_app_role.sql
DATABASE_URL=postgresql://wallet_owner:CHANGE_ME@localhost:5432/tron_wallet

# TRON network: nile (testnet, default) | shasta | mainnet (blocked unless ALLOW_MAINNET=true)
TRON_NETWORK=nile
# Optional: TronGrid API key (needed for production traffic levels)
TRON_API_KEY=
# Optional override; defaults to the official contract for the chosen network
# USDT_CONTRACT=

# Wallet that will receive service + resource fees (Phase 3). Public address only.
TREASURY_ADDRESS=

# Platform account that holds staked TRX for Energy. When it has enough free
# Energy, quotes are priced at the (cheaper) staked cost; otherwise at rental price.
ENERGY_ACCOUNT=
# two_transfers (default) | relayer (only after the audited contract is deployed)
DELIVERY_MODE=two_transfers
RELAYER_CONTRACT=

ALLOW_MAINNET=false
SENDING_ENABLED=false
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=60
QUOTE_TTL_SECONDS=60

SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
TERMS_URL=
MIN_APP_VERSION=0.1.0
